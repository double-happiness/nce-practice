# 复制为 .env 后填写，再用 npm run start:env 启动（.env 已在 .gitignore 里，不会入库）
# 写作 AI 批改（docs/design/ielts-writing-ai-20261126.md）：填了 key 才开启
ANTHROPIC_API_KEY=
# 可选：模型（默认 claude-opus-5-5）、思考深度 low / medium / high / xhigh / max（默认 high）、每日次数上限（默认 20）
# IELTS_AI_MODEL=claude-opus-5-5
# IELTS_AI_EFFORT=high
# IELTS_AI_DAILY_LIMIT=20
# 可选：强制关闭（0）或在用 ant auth login 凭据时强制开启（1）
# IELTS_AI_ENABLED=
# 可选：端口（默认 3737）
# PORT=3737
